# ============================================================
# 诈醒学集 Demo — 环境变量配置示例
# 复制为 .env（或系统环境变量）后按需填写；不填则全部走演示态。
# ============================================================

# ---------- 数据库 ----------
# 默认 SQLite：data/demo.sqlite3（演示够用）。上线建议换 Postgres：
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fraud_pet

# ---------- 安全与鉴权（需求：替换软身份） ----------
# 默认 false：兼容演示，token 可选、缺失时回退 ownerId。
# 正式上线请设为 true：所有新建敏感端点强制要求合法 Bearer Token，否则 401。
AUTH_REQUIRED=false
# 登录令牌签名密钥（演示可用默认值；生产务必替换为强随机值）
APP_SECRET=

# ---------- 校园统一认证（需求#30） ----------
# 认证模式：demo（默认，学号+学校匿名锚点）| cas | oauth
CAMPUS_AUTH_MODE=demo
# 演示态展示用的学校名
CAMPUS_SCHOOL_NAME=示例大学

# CAS 2.0（CAMPUS_AUTH_MODE=cas 时必填）
CAMPUS_CAS_BASE_URL=
CAMPUS_CAS_SERVICE=

# OAuth2 / OIDC（CAMPUS_AUTH_MODE=oauth 时必填）
CAMPUS_OAUTH_TOKEN_URL=
CAMPUS_OAUTH_CLIENT_ID=
CAMPUS_OAUTH_CLIENT_SECRET=
CAMPUS_OAUTH_REDIRECT_URI=
CAMPUS_OAUTH_USERINFO_URL=

# ---------- 真实 LLM 初审 / 答疑（需求#21/#16） ----------
# 不填则使用内置可解释规则引擎（降级可用）。
OPENAI_API_KEY=
# OpenAI 兼容接口地址（可指向 Azure / 本地 vLLM / 通义等兼容网关）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 文件存储（需求#19/#20） ----------
# 默认 local：文件落盘到 data/uploads/，真实持久化且可回读。
# 设为 s3 并配置下方项可切换对象存储（未装 boto3 时自动回退本地）。
STORAGE_BACKEND=local
# S3 / 兼容 MinIO（STORAGE_BACKEND=s3 时生效）
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- 管理端保护 ----------
# 配置后 /api/admin 强制校验 X-Admin-Key 头；未配置则演示态放行。
ADMIN_API_KEY=
